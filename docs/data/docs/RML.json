ww.bseindia.com/bseplus/AnnualReport/532661/5326610319.pdf","source":"bse"},{"kind":"annual_report","date":"","title":"Annual Report 2018","url":"https://www.bseindia.com/bseplus/AnnualReport/532661/5326610318.pdf","source":"bse"},{"kind":"annual_report","date":"","title":"Annual Report 2017","url":"https://www.bseindia.com/bseplus/AnnualReport/532661/5326610317.pdf","source":"bse"},{"kind":"annual_report","date":"","title":"Annual Report 2016","url":"https://www.bseindia.com/bseplus/AnnualReport/532661/5326610316.pdf","source":"bse"},{"kind":"annual_report","date":"","title":"Annual Report 2015","url":"https://www.bseindia.com/bseplus/AnnualReport/532661/5326610315.pdf","source":"bse"},{"kind":"annual_report","date":"","title":"Annual Report 2014","url":"https://www.bseindia.com/bseplus/AnnualReport/532661/5326610314.pdf","source":"bse"},{"kind":"annual_report","date":"","title":"Annual Report 2013","url":"https://www.bseindia.com/bseplus/AnnualReport/532661/5326610313.pdf","source":"bse"},{"kind":"annual_report","date":"","title":"Annual Report 2012","url":"https://www.bseindia.com/bseplus/AnnualReport/532661/5326610312.pdf","source":"bse"}],"analysis":{"summary":"Rane (Madras) Limited reported its Q1 FY27 financial results, highlighting a consolidated total revenue of Rs. 1,050.6 Cr and an EBITDA of Rs. 95.8 Cr. Management announced the acquisition of the friction business of Hindustan Composites Limited, creating a combined friction business exceeding Rs. 1,000 crores.","themes":{"guidance":[],"demand_outlook":[{"claim":"Sales to Domestic OE customers grew by 13% due to higher offtake in the passenger vehicle and farm tractor segments.","quote":"Sales to Domestic OE customers grew by 13% mainly due to higher offtake in the passenger vehicle and farm tractor segment.","doc_kind":"concall_ppt","doc_date":"2026-08-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=aa8831c1-d941-46f5-94c5-0018c9f8f8a7.pdf"},{"claim":"Sales to Indian Aftermarket customers increased by 28%.","quote":"Sales to Indian Aftermarket customers increased by 28%.","doc_kind":"concall_ppt","doc_date":"2026-08-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=aa8831c1-d941-46f5-94c5-0018c9f8f8a7.pdf"},{"claim":"The passenger vehicle segment performance was driven by improved affordability supported by GST reductions, rising disposable incomes, and lower financing costs.","quote":"• The PV segment delivered a strong performance in Q4, driven by improved affordability supported by GST reductions, rising disposable incomes, and lower financing costs.","doc_kind":"concall_ppt","doc_date":"2026-05-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=64136136-7ac2-4583-8daa-54bc47285d9d.pdf"},{"claim":"Growth in the passenger vehicle segment remained skewed towards utility vehicles reflecting evolving consumer preferences and new launches.","quote":"Growth remained skewed towards utility vehicles, reflecting evolving consumer preferences and a steady pipeline of new launches.","doc_kind":"concall_ppt","doc_date":"2026-05-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=64136136-7ac2-4583-8daa-54bc47285d9d.pdf"},{"claim":"Two-wheeler segment growth was supported by strong rural demand, GST cuts, and lower financing costs alongside a continuing premiumization trend.","quote":"• The 2W segment’s growth was supported by strong rural demand, GST cuts and lower financing costs. The premiumization trend continued, with rising traction in premium motorcycles and scooters.","doc_kind":"concall_ppt","doc_date":"2026-05-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=64136136-7ac2-4583-8daa-54bc47285d9d.pdf"},{"claim":"Farm tractor segment recorded robust growth supported by government policies, favorable harvesting conditions, and increasing farm mechanization.","quote":"• The FT segment recorded a robust growth, supported by government policies, favorable harvesting conditions and increasing farm mechanization, reflecting improving rural sentiment and agricultural activity.","doc_kind":"concall_ppt","doc_date":"2026-05-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=64136136-7ac2-4583-8daa-54bc47285d9d.pdf"},{"claim":"The passenger vehicle segment delivered its strongest Q3 driven by festive demand, improved affordability from GST cuts and tax relief, and strong buyer sentiment.","quote":"The PV segment delivered its strongest Q3, driven by festive demand, improved affordability from GST cuts and tax relief and strong buyer sentiment.","doc_kind":"concall_ppt","doc_date":"2026-02-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=37cbeb87-233e-480e-a593-39fa51e79b82.pdf"},{"claim":"The farm tractor segment recorded robust growth sustaining momentum through the quarter on the back of the GST 2.0 rollout, government incentive schemes, and a favorable monsoon.","quote":"The FT segment recorded a robust growth, sustaining strong momentum through the quarter on the back of GST 2.0 rollout, government incentives schemes and favorable monsoon.","doc_kind":"concall_ppt","doc_date":"2026-02-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=37cbeb87-233e-480e-a593-39fa51e79b82.pdf"},{"claim":"Two-wheeler segment growth was driven primarily by improved domestic demand and enhanced affordability supported by higher disposable incomes and favorable macroeconomic conditions.","quote":"The 2W segment’s growth was driven primarily by improved domestic demand and enhanced affordability, supported by higher disposable incomes and favourable macroeconomic conditions.","doc_kind":"concall_ppt","doc_date":"2026-02-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=37cbeb87-233e-480e-a593-39fa51e79b82.pdf"}],"capex_expansion":[],"margins_costs":[{"claim":"Consolidated EBITDA reached Rs. 95.8 Cr with an EBITDA margin of 9.1%.","quote":"Consolidated Revenue EBITDA\nRs 1,050.6 Cr Rs 95.8 Cr\nA\n18.8% YoY 22.0% YoY\nEBITDA Margin PAT\n9.1%\nRs 30.1 Cr\nA\n24 bps YoY\n62.5% YoY","doc_kind":"concall_ppt","doc_date":"2026-08-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=aa8831c1-d941-46f5-94c5-0018c9f8f8a7.pdf"}],"orders_capacity":[{"claim":"Order wins remained strong during Q1 FY27, with 24 new programs secured across multiple vehicle segments.","quote":"Order wins remained strong during Q1 FY27, with 24 new programs secured across multiple vehicle segments.","doc_kind":"concall_ppt","doc_date":"2026-08-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=aa8831c1-d941-46f5-94c5-0018c9f8f8a7.pdf"},{"claim":"New programs represent a Lifetime Value of over Rs. 2,040 Crs, with export programs accounting for 54%.","quote":"These programs represent a Lifetime Value (LTV) of over Rs. 2,040 Crs. Export programs accounted for 54% of the total LTV, reflecting continued traction in international markets.","doc_kind":"concall_ppt","doc_date":"2026-08-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=aa8831c1-d941-46f5-94c5-0018c9f8f8a7.pdf"}],"capital_allocation":[],"risks_headwinds":[]},"management_commitments":[{"claim":"The acquisition will be EPS accretive from year one onwards.","quote":"The acquisition creates a ₹1,000+ crore combined friction business and will be\nEPS accretive from the year one onwards","doc_kind":"concall_ppt","doc_date":"2026-08-01","url":"https://www.bseindia.com/stockinfo/AnnPdfOpen.aspx?Pname=aa8831c1-d941-46f5-94c5-0018c9f8f8a7.pdf","timeframe":""}],"coverage":{"docs_analysed":3,"kinds":["concall_ppt"]}},"_meta":{"model":"gemini-3.6-flash","grounded":true,"facts_kept":13,"facts_dropped_ungrounded":11,"note":"Facts are verbatim-grounded against the company's own documents; claims whose quote was not found were dropped."}}